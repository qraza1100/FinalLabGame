# Normalise text line endings; keep binary assets untouched.
* text=auto

*.cs      text diff=csharp
*.ps1     text eol=crlf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.psd     binary
*.fbx     binary
*.blend   binary
*.ogg     binary
*.mp3     binary
*.wav     binary
*.ttf     binary
*.pdf     binary
*.dll     binary
*.exe     binary
*.resS    binary
*.resource binary
*.assets  binary
