  m_GameObject: {fileID: 1986730310}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.94, b: 0.9, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a561cfeed3731294d83a1b7578976267, type: 3}
    m_FontSize: 27
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<color=#3DF5E0><b>GOAL</b></color>   Find the <b>Moon, Sun and Star sigils</b>.
    Each one opens its matching gate. Claim the <b><color=#FFB43A>Heart of Eternity</color></b>,
    then get back out through the entrance before the timer runs out.\n\n<color=#3DF5E0><b>CONTROLS</b></color>  
    <b>WASD / Arrow keys</b> swim    <b>Shift</b> boost    <b>Space</b> sonar (points
    to your goal)    <b>Esc</b> pause\n\n<color=#3DF5E0><b>OXYGEN</b></color>   Your
    air drains all the time and faster while boosting. Hover over glowing <b>air
    vents</b> to refill. At 0% you lose.\n\n<color=#3DF5E0><b>DANGER</b></color>  
    <b>Urchins</b> and the <b>guardian shark</b> cost oxygen and points. <b>Currents</b>
    push you around.\n\n<color=#3DF5E0><b>SCORE</b></color>   Pearl +10 \xB7 Sigil
    +50 \xB7 Heart +200 \xB7 every second left when you escape +5 \xB7 each hit -20"
